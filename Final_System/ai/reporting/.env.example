# Copy these lines into ai/reporting/.env (the real .env is git-ignored, never commit it)

# ---------- Desktop client (each device/camera) ----------
# Unique name of this device, must be registered on the server (POST /v1/devices)
CIM_DEVICE_ID=device-01
# Address of the central server, empty = don't sync (events stay in the local outbox)
CIM_SERVER_URL=
# API key that the server returned when this device was registered
CIM_API_KEY=

# ---------- Central server (only on the server machine) ----------
# Gemini (already used by the project)
GEMINI_API_KEY=
# Postgres connection, with docker-compose it is already set by the compose file
CIM_DATABASE_URL=postgresql+psycopg://cim:cim_password@localhost:5432/cim
# Key for admin/read endpoints (register device, view events, export report). Choose a long random string
CIM_ADMIN_API_KEY=
# Cloudflare R2 (bucket must be PRIVATE)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
