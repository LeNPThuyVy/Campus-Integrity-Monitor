# =====================================================================
# Campus Integrity Monitor - cấu hình dùng chung cho API, Web (PHP) và Desktop
# Sao chép thành ".env" ở thư mục gốc repository rồi điền giá trị thật.
# KHÔNG commit file .env (đã có trong .gitignore).
# Biến môi trường thật của hệ điều hành / web server luôn được ưu tiên hơn file này.
# =====================================================================

# ---------- SQL Server (bắt buộc) ----------
# Ví dụ: localhost\SQLEXPRESS, 10.0.0.5,1433, tcp:sql.truong.edu.vn,1433
DB_SERVER=
DB_NAME=
# ODBC driver cho API Python (kiểm tra: Get-OdbcDriver hoặc "odbcinst -q -d")
DB_DRIVER=ODBC Driver 18 for SQL Server

# Cách 1 - SQL Server Authentication: điền DB_USER/DB_PASSWORD, để DB_TRUSTED_CONNECTION=no
# Cách 2 - Windows Authentication: DB_TRUSTED_CONNECTION=yes và để trống DB_USER/DB_PASSWORD
#          (API và web server phải chạy bằng tài khoản Windows có quyền trên database)
DB_TRUSTED_CONNECTION=no
DB_USER=
DB_PASSWORD=

# Mã hóa kết nối. Với SQL Server cục bộ dùng chứng chỉ tự ký có thể cần DB_TRUST_SERVER_CERTIFICATE=yes
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no
DB_TIMEOUT=10

# ---------- API (FastAPI) ----------
# Chuỗi bí mật ký access token, tối thiểu 32 ký tự ngẫu nhiên. Tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CIM_AUTH_SECRET=
CIM_TOKEN_TTL_MINUTES=480
CIM_LOGIN_MAX_FAILURES=5
CIM_LOGIN_LOCK_MINUTES=15

# Lưu ảnh bằng chứng (đường dẫn tương đối tính từ thư mục gốc repository)
CIM_EVIDENCE_DIR=Final_System/storage/evidence
CIM_EVIDENCE_RETENTION_DAYS=30
CIM_EVIDENCE_MAX_BYTES=2097152
CIM_RETENTION_INTERVAL_MINUTES=60
CIM_ENABLE_RETENTION_JOB=true
# Bản ghi cũ hơn số ngày này (ví dụ outbox Desktop tồn đọng) sẽ bị từ chối
CIM_EVENT_MAX_AGE_DAYS=7
# Múi giờ của trường (phút lệch so với UTC); Việt Nam = 420
CIM_UTC_OFFSET_MINUTES=420
# Nạp mô hình AI cho endpoint /predictions (tắt nếu máy chủ API chỉ phục vụ Web/Desktop)
CIM_ENABLE_INFERENCE=false
# Font .ttf hỗ trợ tiếng Việt cho xuất PDF (tự dò Arial/Segoe UI trên Windows, DejaVu trên Linux)
CIM_PDF_FONT_PATH=

# ---------- Web (PHP) ----------
CIM_API_BASE_URL=http://127.0.0.1:8000
CIM_WEB_SESSION_IDLE_MINUTES=30

# ---------- Desktop ----------
# Có thể nhập trực tiếp trong giao diện Desktop (lưu vào Final_System/desktop/config.json, không commit).
CIM_DESKTOP_API_URL=http://127.0.0.1:8000
CIM_DESKTOP_CAMERA_CODE=
CIM_DESKTOP_DEVICE_KEY=

# ---------- Báo cáo AI (tùy chọn) ----------
GEMINI_API_KEY=
