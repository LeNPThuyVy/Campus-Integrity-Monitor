APP_NAME="Campus Integrity Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQL Server (sqlsrv) - Kết nối CSDL chung với hệ thống API CIM
DB_CONNECTION=sqlsrv
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=CampusIntegrityMonitor
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=yes
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_PORT=1433

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Campus Integrity Monitor Config
CIM_API_BASE_URL=http://127.0.0.1:8000
CIM_WEB_SESSION_IDLE_MINUTES=30
